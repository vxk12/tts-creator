   "versionNonce": 1002170858,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Die Formeln\n\nSteuervorteil = (Einkauf − Verkauf) × Steuersatz\nZurück = Verkauf + Steuervorteil\n\nEchter Verlust = (Einkauf − Verkauf) × (1 − Steuersatz)\n                       = Einkauf − Zurück",
   "originalText": "Die Formeln\n\nSteuervorteil = (Einkauf − Verkauf) × Steuersatz\nZurück = Verkauf + Steuervorteil\n\nEchter Verlust = (Einkauf − Verkauf) × (1 − Steuersatz)\n                       = Einkauf − Zurück",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rectangle-f52ddf5d",
   "autoResize": true,
   "lineHeight": 1.25
  },
