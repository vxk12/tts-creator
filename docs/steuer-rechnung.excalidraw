   "seed": 1083438814,
   "version": 1,
   "versionNonce": 1492026737,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Warum fragen wir deinen Steuersatz ab?\n\nJe höher dein Steuersatz, desto mehr kommt über die Steuer zurück. Gleiches Sample, Stufe Fair (18,90 €):\n0 % → zurück 18,90 €      30 % → zurück 21,33 €      42 % → zurück 22,30 €",
   "originalText": "Warum fragen wir deinen Steuersatz ab?\n\nJe höher dein Steuersatz, desto mehr kommt über die Steuer zurück. Gleiches Sample, Stufe Fair (18,90 €):\n0 % → zurück 18,90 €      30 % → zurück 21,33 €      42 % → zurück 22,30 €",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rectangle-895fd7b3",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text-9a2ef80f",
   "type": "text",
   "x": 0,
   "y": 1190,
   "width": 1041.6000000000001,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2036465042,
   "version": 1,
   "versionNonce": 527603371,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Schätzung, keine Steuerberatung. Annahme: Der Verlust aus dem Verkauf ist steuerlich absetzbar. Werte auf den Cent gerundet.",
   "originalText": "Schätzung, keine Steuerberatung. Annahme: Der Verlust aus dem Verkauf ist steuerlich absetzbar. Werte auf den Cent gerundet.",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
